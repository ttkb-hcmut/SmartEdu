    "Q830687": {
      "id": "Q830687",
      "name": "reinforcement learning",
      "content": "type of machine learning where an agent learns how to behave in an environment by performing actions and receiving rewards or penalties in return, aiming to maximize the cumulative reward over time"
    },
    "Q830687_Definition": {
      "id": "Q830687_Definition",
      "name": "reinforcement learning_Definition",
      "content": "Finally, in reinforcement learning, the Machine Learning algorithm is trained by interacting with a (virtual) environment.",
      "concept_id": "Q830687",
      "rrole": "Definition",
      "score": 1
    },
    "Q830687_Application": {
      "id": "Q830687_Application",
      "name": "reinforcement learning_Application",
      "content": "Reinforcement learning is used in tasks in which the learning depends on executed actions and their produced consequences, for instance, playing strategy computer games such as DOTA (OpenAI et al., 2019) or Starcraft (Vinyals et al., 2019).",
      "concept_id": "Q830687",
      "rrole": "Application",
      "score": 1
    },
