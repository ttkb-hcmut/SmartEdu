    },
    "Q334384": {
      "id": "Q334384",
      "name": "supervised learning",
      "content": "machine learning task of learning a function that maps an input to an output based on example input-output pairs"
    },
    "Q334384_Definition": {
      "id": "Q334384_Definition",
      "name": "supervised learning_Definition",
      "content": "In supervised learning, the algorithm is presented with examples for the “correct” execution of the task, and the model is trained to minize the differences its own and the “correct” actions.",
      "concept_id": "Q334384",
      "rrole": "Definition",
      "score": 1
    },
