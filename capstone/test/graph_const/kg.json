{
  "nodes": {
    "Q2539": {
      "id": "Q2539",
      "name": "machine learning",
      "content": "scientific study of algorithms and statistical models that computer systems use to perform tasks without explicit instructions"
    },
    "Q7239673": {
      "id": "Q7239673",
      "name": "predictive modelling",
      "content": "Statistical and machine learning modelling with the goal of predicting outcomes"
    },
    "Q7239673_Objective": {
      "id": "Q7239673_Objective",
      "name": "predictive modelling_Objective",
      "content": "The objective of ML is to build a good predictive model.",
      "concept_id": "Q7239673",
      "rrole": "Objective",
      "score": 1
    },
    "Q7239673_Definition": {
      "id": "Q7239673_Definition",
      "name": "predictive modelling_Definition",
      "content": "By “good”, we mean that the model should predict well to new data.",
      "concept_id": "Q7239673",
      "rrole": "Definition",
      "score": 1
    },
    "Q331309": {
      "id": "Q331309",
      "name": "overfitting",
      "content": "production of an analysis that corresponds too closely or exactly to a particular set of data, and may therefore fail to fit additional data or predict future observations reliably"
    },
    "Q331309_Definition": {
      "id": "Q331309_Definition",
      "name": "overfitting_Definition",
      "content": "we say the model overfits",
      "concept_id": "Q331309",
      "rrole": "Definition",
      "score": 1
    },
    "Q331309_Problem": {
      "id": "Q331309_Problem",
      "name": "overfitting_Problem",
      "content": "A more complex and flexible model has a higher risk of overfitting.",
      "concept_id": "Q331309",
      "rrole": "Problem",
      "score": 1
    },
    "Q17003119": {
      "id": "Q17003119",
      "name": "bias–variance tradeoff",
      "content": "property of a set of predictive models whereby models with a lower bias in parameter estimation have a higher variance of the parameter estimates across samples, and vice versa"
    },
    "Q17003119_Statement": {
      "id": "Q17003119_Statement",
      "name": "bias–variance tradeoff_Statement",
      "content": "The trade-off between complexity and flexibility can be depicted by the bias-variance tradeoff (Box 3).",
      "concept_id": "Q17003119",
      "rrole": "Statement",
      "score": 1
    },
    "local_45eb685c": {
      "id": "local_45eb685c",
      "name": "Model Generalization",
      "content": "so that the fitted model generalizes well to new data."
    },
    "local_45eb685c_Objective": {
      "id": "local_45eb685c_Objective",
      "name": "Model Generalization_Objective",
      "content": "so that the fitted model generalizes well to new data.",
      "concept_id": "local_45eb685c",
      "rrole": "Objective",
      "score": 1
    },
    "local_45eb685c_Solution": {
      "id": "local_45eb685c_Solution",
      "name": "Model Generalization_Solution",
      "content": "adjust their parameters to the data (training), while simultaneously adapt its complexity by optimizing the bias-variance trade-off",
      "concept_id": "local_45eb685c",
      "rrole": "Solution",
      "score": 1
    },
    "Q1152135": {
      "id": "Q1152135",
      "name": "unsupervised learning",
      "content": "machine learning technique"
    },
    "Q1152135_Definition": {
      "id": "Q1152135_Definition",
      "name": "unsupervised learning_Definition",
      "content": "In unsupervised learning it depends on the method, but a common approach is to use similarities between observations to decide if observations are grouped together or not",
      "concept_id": "Q1152135",
      "rrole": "Definition",
      "score": 1
    },
    "Q1068473": {
